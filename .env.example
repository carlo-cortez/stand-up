# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both are safe in the browser: row-level security is what protects the data.
# Leave them unset and the app runs exactly as before — local only, no account.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Feedback (M2.5). Server-side only — NO VITE_ prefix, or it ships to every
# visitor. Needed by api/feedback.ts, which runs under `vercel dev` or on
# Vercel, never under `npm run dev`. One key covers both models.
GROQ_API_KEY=
# Optional overrides; model ids move.
GROQ_STT_MODEL=
GROQ_TEXT_MODEL=
